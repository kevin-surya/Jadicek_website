{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/predict.py": {
      "includeFiles": "{models/**,model_service.py,notebook_pipeline.py}",
      "excludeFiles": "{train_models.py,server.py,README.md,**/__pycache__/**,**/*.pyc}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
